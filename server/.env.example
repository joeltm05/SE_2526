# Local development with SQLite
DB_DIALECT=sqlite
SQLITE_FILE=./data/parking.sqlite
PORT=3001
CORS_ORIGIN=http://localhost:5173

# SMTP optional (for email notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=youruser
# SMTP_PASS=yourpass
# SMTP_FROM=estacionamento@exemplo.pt

# Production (example for Postgres on Neon/Supabase/Railway)
# DB_DIALECT=postgres
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DB_SSL=true   # defina true se o fornecedor exigir TLS/SSL
